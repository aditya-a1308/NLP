import spacy
import nltk
from nltk import RegexpParser, pos_tag, word_tokenize

nltk.download('averaged_perceptron_tagger')
nltk.download('punkt')

# --- Part 1: POS Tagging with spaCy ---
nlp = spacy.load("en_core_web_sm")
sentence = "The quick brown fox jumps over the lazy dog"
doc = nlp(sentence)

print("POS Tags (spaCy):")
for token in doc:
    print(f"  {token.text:12} | POS: {token.pos_:8} | Tag: {token.tag_}")

# --- Part 2: Chunking with NLTK ---
# Noun Phrase grammar: optional determiner + any adjectives + noun
grammar = "NP: {
?*}"
chunk_parser = RegexpParser(grammar)

# NLTK needs (word, tag) tuples
tagged = pos_tag(word_tokenize(sentence))
print("\nNLTK POS Tags:", tagged)

tree = chunk_parser.parse(tagged)
print("\nChunk Tree:")
print(tree)

# --- Part 3: Dependency Parsing with spaCy ---
print("\nDependency Relations:")
for token in doc:
    print(f"  {token.text:12} --[{token.dep_}]--> {token.head.text}")

# Visual (works in Jupyter)
