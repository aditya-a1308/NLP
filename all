1-text processing---------------------------------------------------------------------------------

import nltk
from nltk.tokenize import word_tokenize, sent_tokenize
from nltk.corpus import stopwords
from nltk.stem import PorterStemmer, WordNetLemmatizer
from collections import Counter
import string

nltk.download('punkt')
nltk.download('stopwords')
nltk.download('wordnet')

text = """Natural language processing enables computers to understand human language.
Language processing is used in machine translation and sentiment analysis.
Processing text data requires tokenization and stopword removal."""

# Step 1: Sentence Tokenization
sentences = sent_tokenize(text)
print("Sentences:", sentences)

# Step 2: Word Tokenization
words = word_tokenize(text)
print("Tokens:", words)

# Step 3: Remove Punctuation
words = [w for w in words if w not in string.punctuation]

# Step 4: Lowercase
words = [w.lower() for w in words]

# Step 5: Remove Stopwords
stop_words = set(stopwords.words('english'))
filtered = [w for w in words if w not in stop_words]
print("After stopword removal:", filtered)

# Step 6: Stemming
stemmer = PorterStemmer()
stemmed = [stemmer.stem(w) for w in filtered]
print("Stemmed:", stemmed)

# Step 7: Lemmatization
lemmatizer = WordNetLemmatizer()
lemmatized = [lemmatizer.lemmatize(w) for w in filtered]
print("Lemmatized:", lemmatized)

# Step 8: Frequency Analysis
freq = Counter(filtered)
print("Word Frequencies:", freq.most_common(5))



